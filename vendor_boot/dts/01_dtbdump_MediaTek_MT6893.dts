/dts-v1/;

/ {
	model = "MediaTek MT6893";
	compatible = "mediatek,mt6893";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@11015000";
		i2c1 = "/soc/i2c@11d00000";
		i2c2 = "/soc/i2c@11d01000";
		i2c3 = "/soc/i2c@11cb0000";
		i2c4 = "/soc/i2c@11d02000";
		i2c5 = "/soc/i2c@11f00000";
		i2c6 = "/soc/i2c@11f01000";
		i2c7 = "/soc/i2c@11d03000";
		i2c8 = "/soc/i2c@11d04000";
		i2c9 = "/soc/i2c@11cb1000";
		i2c10 = "/soc/i2c@11017000";
		i2c11 = "/soc/i2c@1101a000";
		i2c12 = "/soc/i2c@1101b000";
		i2c13 = "/soc/i2c@11007000";
		ovl0 = "/soc/disp-ovl0@14000000";
		ovl1 = "/soc/disp-ovl1@14100000";
		ovl3 = "/soc/disp-ovl0-2l@14001000";
		ovl4 = "/soc/disp-ovl1-2l@14101000";
		ovl5 = "/soc/disp-ovl2-2l@14002000";
		ovl6 = "/soc/disp-ovl3-2l@14102000";
		rdma0 = "/soc/disp-rdma0@14003000";
		rdma1 = "/soc/disp-rdma1@14103000";
		rdma4 = "/soc/disp-rdma4@14005000";
		rdma5 = "/soc/disp-rdma5@14105000";
		wdma0 = "/soc/disp-wdma0@14006000";
		wdma1 = "/soc/disp-wdma1@14106000";
		color0 = "/soc/disp-color0@14007000";
		color1 = "/soc/disp-color1@14107000";
		ccorr0 = "/soc/disp-ccorr0@14008000";
		ccorr1 = "/soc/disp-ccorr1@14108000";
		aal0 = "/soc/disp-aal0@14009000";
		aal1 = "/soc/disp-aal1@14109000";
		gamma0 = "/soc/disp-gamma0@1400a000";
		gamma1 = "/soc/disp-gamma1@1410a000";
		dither0 = "/soc/disp-dither0@1400b000";
		dither1 = "/soc/disp-dither1@1410b000";
		postmask0 = "/soc/disp-postmask0@1400d000";
		postmask1 = "/soc/disp-postmask1@1410d000";
		dsi0 = "/soc/dsi@1400e000";
		merge1 = "/soc/disp-merge1@14115000";
		rsz0 = "/soc/disp-rsz0@1400c000";
		rsz1 = "/soc/disp-rsz1@1410c000";
		maal0 = "/soc/mdp_aal4@14010000";
		maal1 = "/soc/mdp_aal5@14110000";
		mtksmmu0 = "/soc/iommu@1411a000";
		mtksmmu1 = "/soc/iommu@1f027000";
		mtksmmu2 = "/soc/iommu@19010000";
		mtksmmu3 = "/soc/iommu@19015000";
	};

	atf_logger {
		compatible = "mediatek,atf_logger";
		phandle = <0x12f>;
	};

	chosen {
		bootargs = "root=/dev/ram vmalloc=400M \t\t8250.nr_uarts=2 \t\tinitcall_debug=1 \t\tloglevel=8 \t\trcupdate.rcu_expedited=1 swiotlb=noforce transparent_hugepage=never \t\tfirmware_class.path=/vendor/firmware \t\tloop.max_part=7 snd-usb-audio.use_vmalloc=0 \t\tallow_mismatched_32bit_el0 fake_cpu_32bit_el0_mask=0x70";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x2e>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x00>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04 0x00>;
		cpus = <0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	clkitg {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0x130>;

		bring-up {
			compatible = "mediatek,clk-bring-up";
			clocks = <0x0a>;
		};
	};

	disable_unused {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0x131>;

		disable-unused-clk-ipesys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x0b 0x00 0x0b 0x01 0x0b 0x02 0x0b 0x03 0x0b 0x04 0x0b 0x05 0x0b 0x06>;
			power-domains = <0x0c 0x09>;
		};

		disable-unused-clk-camsys_rawc {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x0d 0x00 0x0d 0x01 0x0d 0x02>;
			power-domains = <0x0c 0x15>;
		};

		disable-unused-clk-camsys_rawb {
